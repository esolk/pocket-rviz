<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Arbitrary user-entered LAN Foxglove bridge addresses cannot be enumerated here.
         Cleartext is needed for ws://; only bundled content can run in the WebView.
         CSP restricts remote connections to WebSockets. Prefer wss:// off a trusted LAN. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
