<?xml version="1.0"?>
<!-- Example only; this file has not been executed on a robot.
     Default loopback binding intentionally prevents LAN access. -->
<launch>
  <arg name="address" default="127.0.0.1" />
  <arg name="port" default="8765" />
  <arg name="tls" default="false" />
  <arg name="certfile" default="" />
  <arg name="keyfile" default="" />
  <arg name="topics" default="['^/tf$', '^/tf_static$', '^/points_raw$', '^/scan$', '^/map$', '^/plan$', '^/odom$', '^/visualization_marker$', '^/visualization_marker_array$', '^/camera/image/compressed$']" />
  <include file="$(find foxglove_bridge)/launch/foxglove_bridge.launch">
    <arg name="address" value="$(arg address)" />
    <arg name="port" value="$(arg port)" />
    <arg name="tls" value="$(arg tls)" />
    <arg name="certfile" value="$(arg certfile)" />
    <arg name="keyfile" value="$(arg keyfile)" />
    <arg name="topic_whitelist" value="$(arg topics)" />
    <arg name="capabilities" value="[]" />
    <arg name="client_topic_whitelist" value="[]" />
    <arg name="service_whitelist" value="[]" />
    <arg name="param_whitelist" value="[]" />
    <arg name="asset_uri_allowlist" value="[]" />
    <arg name="send_buffer_limit" value="4000000" />
  </include>
</launch>
